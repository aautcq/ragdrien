# Base URL of the local Ollama instance. Shared by both the chat model and
# the embedding model used for RAG ingestion.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model used to generate assistant replies.
OLLAMA_MODEL=mistral:latest

# Embedding model used to vectorize RAG document chunks.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Number of candidate chunks pulled from the vector store per query, before
# filtering by RAG_RELEVANCE_THRESHOLD.
RAG_RETRIEVAL_K=4

# Minimum cosine similarity (0-1) a chunk must reach against the query to be
# injected into the prompt as grounding context.
RAG_RELEVANCE_THRESHOLD=0.5
